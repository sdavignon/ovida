# Playback engine selection
AUDIO_MODE=files          # files | realtime | auto
AUDIO_FILE_ENGINE=elevenlabs # elevenlabs | coqui
REALTIME_ENABLED=false    # guards WebRTC flow even if selected
NODE_ENV=development      # dev | staging | production

# ElevenLabs (optional for files mode; mock if missing)
ELEVENLABS_STREAMING=off
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_ID=placeholder_voice
ELEVENLABS_MODEL=eleven_turbo_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Coqui TTS (optional for local files mode)
COQUI_TTS_URL=http://127.0.0.1:5002/api/tts
COQUI_TTS_SPEAKER=
COQUI_TTS_VOICE=
COQUI_TTS_LANGUAGE=
COQUI_TTS_STYLE_WAV=
COQUI_TTS_SPEED=

# OpenAI (for realtime audio and image generation)
OPENAI_API_KEY=replace_me
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_BASE_URL=https://api.openai.com
OPENAI_REALTIME_VOICE=verse

# Supabase
# For local development, use localhost
# For production, use: https://[project-ref].supabase.co
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Production example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase (Web App - Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# API origins
# Local development:
#   API_ORIGIN=http://localhost:4000
#   APP_ORIGIN=http://localhost:8081
#   WS_ORIGIN=ws://localhost:4001/ws
#   NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
#   NEXT_PUBLIC_WS_ORIGIN=ws://localhost:4001/ws
# Production (https://ovida.1976.cloud/):
PORT=4000
API_ORIGIN=https://ovida.1976.cloud:4000
APP_ORIGIN=https://ovida.1976.cloud
WS_ORIGIN=wss://ovida.1976.cloud:4001/ws
NEXT_PUBLIC_API_ORIGIN=https://ovida.1976.cloud:4000
NEXT_PUBLIC_WS_ORIGIN=wss://ovida.1976.cloud:4001/ws

# Private video rendering API
VIDEO_API_KEY=replace_me
VIDEO_TMP_DIR=
VIDEO_OUTPUT_DIR=
VIDEO_PUBLIC_BASE_URL=
VIDEO_MAX_INPUT_BYTES=1000000000
VIDEO_MAX_OVERLAY_BYTES=50000000
VIDEO_MAX_AUDIO_BYTES=200000000
VIDEO_CALLBACK_TIMEOUT_MS=10000

# Auth (handled by Supabase dashboard)
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
